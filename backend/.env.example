# Copiá este archivo como .env y completá los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# ── Django ────────────────────────────────────────────────────────────────
# Clave secreta de Django. Generá una nueva para cada entorno con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiame-por-una-clave-generada

# True solo en desarrollo. En producción tiene que ser False.
DEBUG=True

# ── Base de datos ─────────────────────────────────────────────────────────
# URL completa de PostgreSQL. Render la inyecta sola al enlazar una base.
DATABASE_URL=postgresql://refugio_user:refugio_pass@localhost:5432/refugio_db
# Para correr los tests sin levantar Postgres:
#   DATABASE_URL=sqlite:///dev.sqlite3 python manage.py test

# ── CORS ──────────────────────────────────────────────────────────────────
# Orígenes del frontend autorizados a llamar a la API, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────
# Clave con la que se firman los tokens. Si se omite, se usa SECRET_KEY.
JWT_SECRET_KEY=cambiame-por-otra-clave-generada

# ── Logging (opcional) ────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG

# ── Seguridad en producción (solo cuando DEBUG=False) ─────────────────────
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ── Solo para docker-compose ──────────────────────────────────────────────
# Valores con los que se crea el contenedor de PostgreSQL.
DB_NAME=refugio_db
DB_USER=refugio_user
DB_PASSWORD=refugio_pass
